[user]
	email = andrew.t.shaw@gmail.com
	name = Andrew Shaw

[alias]
	st = status
	co = checkout
	ci = commit
	br = branch
	cp = cherry-pick
	rb = rebase
	rbi = rebase -i
	rba = rebase --abort
	rbc = rebase --continue
	# pretty one-line log, current branch / all branches
	lol = log --graph --decorate --date=relative --pretty=format:"%C(auto)%h%C(auto)%d\\ %Creset%s%Cblue\\ [%cn\\ -\\ %ad]"
	lola = "!git lol --all"

[color]
	ui = auto

[core]
	whitespace = -trailing-space
	autocrlf = input
	excludesfile = ~/.gitignore

[push]
	default = simple
